# Copy to .env for local development. On Render, set these in the service's Environment tab.

# Only needed while the old Supabase edge function is still in use. Leave empty after cutover.
# Shared secret: the Supabase edge function must send the same value in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=
# Required. Secret for signing sign-in sessions (generate the same way as above, different value).
JWT_SECRET=

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Required. The OAuth client ID used by the website's Google sign-in button.
GOOGLE_CLIENT_ID=

# Optional
ALLOWED_ORIGINS=https://slickreceipts.com,https://www.slickreceipts.com
# Production: the Neon (or Render) Postgres connection string.
DATABASE_URL=sqlite:///./local.db
MAX_FILES_PER_REQUEST=10
MAX_FILE_MB=10
FREE_FILE_LIMIT=10
MAX_FILES_PER_HOUR=60
SESSION_DAYS=14
